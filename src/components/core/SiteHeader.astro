---
const data = {
  brandName: 'Bloom',
  items: [
    { label: 'About', href: '/about', current: true },
    { label: 'Dashboard', href: '/dashboard' },
  ],
};

const { user } = Astro.props;
---

<header class="site-head">
  <div class="wrapper">
    <div class="repel site-head__inner">
      <div class="site-head__brand">
        <a href="/">
          { data.brandName }
        </a>
      </div>
      <nav aria-label="primary" class="nav">
        <ul class="cluster" role="list">
          {data.items.map((item) => (
          <li>
            <a href={item.href} {...(item.current ? {'aria-current': 'page'} : {})}>{item.label}</a>
          </li>
        ))}
        <li>
          {user ? <button id="logout">Logout</button> : <button id="login">Login</button>}
        </li>
        </ul>
      </nav>
    </div>
    <hr/>
  </div>
</header>

<script>
	const { signIn, signOut } = await import("../../lib/auth-client")

	const loginBtn = document.querySelector("#login");
	const logoutBtn = document.querySelector("#logout");
	
	if (loginBtn) {
		loginBtn.onclick = () => signIn.social({
			provider: "github",
			callbackURL: "/dashboard",
		})
	}
	
	if (logoutBtn) {
		logoutBtn.onclick = async () => {
			await signOut();
			window.location.href = "/";
		}
	}
</script>